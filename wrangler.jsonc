{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "islanderhomephuket",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.islanderhomephuket.com", "custom_domain": true },
    { "pattern": "islanderhomephuket.com", "custom_domain": true }
  ],
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "islanderhomephuket" }
  ],
    "kv_namespaces": [
    { "binding": "NEXT_TAG_CACHE_KV", "id": "2e6bfacf374a42c6b22cd7d5fdb101c2" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ],
  "observability": { "enabled": true }
}
